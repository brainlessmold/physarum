{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  // The app build typechecks the app. Tests run through node's own type
  // stripping and use node globals (process.exit), which this config has no
  // types for — including them here breaks `tsc --noEmit` and therefore the
  // deploy. Type errors in tests still surface when they run.
  "include": ["src"]
}
